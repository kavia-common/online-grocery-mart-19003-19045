# Service configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# API Key security (optional; if not set, auth is disabled)
API_KEY_HEADER=X-API-KEY
API_KEY_VALUE=replace-with-secure-value

# Database (use either DATABASE_URL or discrete PG* variables)
# Example DATABASE_URL: postgres://user:password@host:5432/product_catalog_db?sslmode=require
DATABASE_URL=

# Or discrete variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=product_catalog_db
PGSSL=false

# Pool tuning (optional)
PGPOOL_MAX=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000
